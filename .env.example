# Copy to .env. Never commit .env. No secrets use a VITE_ prefix.
DATABASE_PATH=.data/agency.sqlite
# Generate with: node server/password.js
ADMIN_PASSWORD_HASH=
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Set your actual HTTPS origin before deployment; enables sitemap generation.
PUBLIC_SITE_URL=
PORT=3001
NODE_ENV=development
